<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PizzaApiTesterApp.AuthTestsPage"
             xmlns:vm="clr-namespace:PizzaApiTesterApp"
             x:DataType="vm:AuthTestsPageViewModel"
             Title="AuthTestsPage">
    <VerticalStackLayout Spacing="5">
        <Label Text="{Binding Info}"/>
        <Button Text="Pizza ^_^" Command="{Binding GetIngredientsCommand}"/>
        <Button Text="Login Kulfon ^_^" Command="{Binding LoginUserCommand}"/>
        <Button Text="test" Command="{Binding FactoryTestCommand}"/>
    </VerticalStackLayout>
</ContentPage>
